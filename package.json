{
  "name": "bukuku",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BukuKu — pencatat keuangan offline-first dengan jurnal debit-kredit otomatis, laporan akuntansi Indonesia, dan sinkronisasi Google Sheets.",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');for(const p of ['dist','server.js'])fs.rmSync(p,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/core/accounting.test.ts src/core/hardening.test.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
